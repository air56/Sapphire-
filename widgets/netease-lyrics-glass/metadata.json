{
  "name": "netease-lyrics-glass",
  "displayName": "网易云双语歌词玻璃条",
  "description": "自动识别网易云当前播放歌曲，显示原文、中文翻译和下一句。",
  "version": "0.1.13",
  "author": "Codex",
  "tags": ["网易云", "歌词", "Liquid Glass", "音乐"],
  "widgetType": "Html",
  "widgetFileName": "index.html",
  "previewImageFileName": "preview.png",
  "acceptsMouseEvents": true,
  "mouseEventMode": 2,
  "mouseEventModeLabel": "OnlyNonEdit",
  "functions": ["SMTC"],
  "defaultGridSize": { "rows": 1, "cols": 5 },
  "defaultWidth": 960,
  "defaultHeight": 216,
  "width": 960,
  "height": 216,
  "defaultShowBackground": false,
  "network": true,
  "permissions": ["network"],
  "minimumAppVersion": "1.6.0.0",
  "customFields": {
    "bridgeEndpoint": "http://127.0.0.1:18763",
    "layout": "responsive-liquid-glass"
  }
}

